rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── interviews ──────────────────────────────────────────────────────────
    // Each interview document stores the owner's Clerk user ID in the `userId`
    // field. After the Clerk→Firebase Auth bridge runs, request.auth.uid equals
    // the Clerk user ID, so ownership is enforced cryptographically.
    match /interviews/{interviewId} {
      // Only the owner can read their own interviews
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Only the authenticated user can create their own interview.
      // The userId field in the new document must equal the caller's uid.
      // resource.data does not exist for CREATE — use request.resource.data.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Owner can update, but cannot transfer ownership to another user.
      // Both the existing userId and the incoming userId must match the caller.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;

      // Owner can delete their own interview
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── userAnswers ─────────────────────────────────────────────────────────
    match /userAnswers/{answerId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Owner can update, but cannot change the userId to another user
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── users ───────────────────────────────────────────────────────────────
    // The document ID in the users collection is the Clerk user ID.
    // Only the authenticated user can read or write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
