# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (Serverless / Vercel — NEVER prefix with VITE_)
# ==============================================================================
CLERK_SECRET_KEY=
MONGODB_URI=
GEMINI_API_KEY=

# Optional: Clerk JWT Public Key (if using asymmetric JWT verification)
# CLERK_JWT_KEY=

# Optional: CORS allowed origins (comma-separated, defaults to deployment origin)
# APP_ORIGIN=

# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite / Public)
# ==============================================================================
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: Set to "true" for offline mock AI generation during development
# VITE_MOCK_GEMINI=false
