# ── Clerk (public, frontend) ─────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=

# ── Gemini AI (public, frontend) ─────────────────────────────────────────────
VITE_GEMINI_API_KEY=

# ── Firebase (public, frontend) ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloud Function URL (public, frontend) ────────────────────────────────────
# Set this after deploying the exchangeToken Cloud Function.
# Format: https://<region>-<project-id>.cloudfunctions.net/exchangeToken
# For local emulator: http://127.0.0.1:5001/<project-id>/<region>/exchangeToken
VITE_EXCHANGE_TOKEN_URL=

# ── SERVER-ONLY SECRETS — set via Firebase Secret Manager, NEVER commit ──────
# firebase functions:secrets:set CLERK_SECRET_KEY
# firebase functions:secrets:set CLERK_PUBLISHABLE_KEY
# firebase functions:secrets:set CLERK_JWT_KEY
#
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
