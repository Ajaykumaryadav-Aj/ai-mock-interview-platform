# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite / Public)
# ==============================================================================

# ── Clerk Authentication (Frontend) ──────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ── Firebase Web Client Configuration ─────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-interview-1842f
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ── Token Exchange Endpoint (Defaults to /api/exchangeToken if empty) ────────
# VITE_EXCHANGE_TOKEN_URL=/api/exchangeToken

# ── Local Development Toggles (Optional) ──────────────────────────────────────
# Set to "true" to route Auth and Firestore to local Firebase Emulators (127.0.0.1)
# VITE_USE_EMULATOR=false

# Set to "true" for offline mock AI generation without consuming Gemini quota
# VITE_MOCK_GEMINI=false

# Optional fallback for local offline Vite development without Vercel CLI
# VITE_GEMINI_API_KEY=


# ==============================================================================
# VERCEL SERVERLESS FUNCTIONS SECRETS (Server-Only — NEVER prefix with VITE_)
# Add these directly in Vercel Project Settings → Environment Variables
# ==============================================================================

# ── Clerk Server-Side Verification ────────────────────────────────────────────
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Firebase Admin SDK (Service Account Credentials) ──────────────────────────
# Generate in Firebase Console → Project Settings → Service accounts → Generate new private key
# FIREBASE_PROJECT_ID=ai-interview-1842f
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ai-interview-1842f.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ── Gemini AI Server-Side Proxy ───────────────────────────────────────────────
# Protects your Gemini API key from exposure in the browser bundle
# GEMINI_API_KEY=AIzaSyYourServerGeminiApiKey

# ── Allowed Production Frontend Origin (CORS Protection) ─────────────────────
# APP_ORIGIN=https://your-app.vercel.app
